---
import Link from "../fundations/elements/Link.astro";

const { class: className = "", ...rest } = Astro.props;
---

<p class={` ${className}`} {...rest} aria-label="CityTrail Adresse">
    <span><b>CityTrail GmbH</b></span><br />
    <span>Resselgasse 4</span><br />
    <span>1040 Wien</span><br />
    <span>Österreich</span><br />
    <span>Telefon: <Link eref="tel:+431234567">+43 123 4567890</Link></span><br
    />
    <span
        >E-Mail: <Link eref="mailto:contact@city-trail.at"
            >contact@city-trail.at</Link
        ></span
    ><br />
</p>
