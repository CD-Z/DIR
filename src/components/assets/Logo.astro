---
// Logo Component – CityTrail Wortbildmarke
// Props: class, ...rest
const { class: className = "", ...rest } = Astro.props;
---

<span
    class={`inline-flex items-center gap-2 text-xl font-bold tracking-tight ${className}`}
    {...rest}
    aria-label="CityTrail Startseite"
>
    <!-- Bildmarke: stilisierter Kompass/Trail -->
    <svg
        width="28"
        height="28"
        viewBox="0 0 28 28"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
        class="shrink-0 antialiased"
    >
        <circle cx="14" cy="14" r="12" stroke="currentColor" stroke-width="2.5"
        ></circle>
        <path
            d="M14 4 L16 12 L24 14 L16 16 L14 24 L12 16 L4 14 L12 12 Z"
            fill="currentColor"></path>
    </svg>
    <!-- Wortmarke -->
    <span class="text-accent-950">CityTrail</span>
</span>
