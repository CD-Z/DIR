---
// Logo Component – CityTrail Wortbildmarke
// Props: class, ...rest
const { class: className = "", ...rest } = Astro.props;
---

<span
    class={`inline-flex items-center gap-0.5 text-xl font-bold tracking-tight ${className}`}
    {...rest}
    aria-label="CityTrail Startseite"
>
    <!-- Bildmarke: stilisierter Kompass/Trail -->
    <span class="text-accent-950">City</span>
    <svg
        width="24"
        height="24"
        viewBox="0 0 64 64"
        fill="none"
        xmlns="http://www.w3.org/2000/svg"
        aria-hidden="true"
        class="shrink-0 antialiased text-accent-950"
    >
        <circle cx="32" cy="32" r="26" stroke="currentColor" stroke-width="5.5"
        ></circle>
        <path
            d="M32 14L37 27L50 32L37 37L32 50L27 37L14 32L27 27Z"
            fill="currentColor"></path>
        <circle cx="32" cy="32" r="4" fill="white"></circle>
    </svg>
    <!-- Wortmarke -->
    <span class="text-accent-950">Trail</span>
</span>
