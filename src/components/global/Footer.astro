---
// Assets
import Logo from "@/components/assets/Logo.astro";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Address from "../assets/Address.astro";
import Link from "../fundations/elements/Link.astro";
const sections = [
    {
        title: "Seiten",
        links: [
            { name: "Startseite", href: "/" },
            { name: "Über uns", href: "/about" },
            { name: "Kontaktformular", href: "/contact" },
            { name: "Login", href: "/login" },
            { name: "Registrieren", href: "/signup" },
        ],
    },
    {
        title: "Rechtliches",
        links: [
            { name: "Datenschutz​erklärung", href: "/terms" },
            { name: "KI-Transparenz", href: "/ai-disclaimer" },
            { name: "Barrierefreiheit", href: "/accessibility" },
            { name: "Lizenz", href: "/license" },
            { name: "Urheberrechte", href: "/credits" },
        ],
    },
];
const currentYear = new Date().getFullYear();
---

<footer>
    <Wrapper variant="standard" class="py-12">
        <div
            class="grid sm:grid-cols-2 lg:grid-cols-5 items-start gap-x-8 gap-y-8 sm:gap-y-24"
        >
            <div class="flex flex-col justify-between h-full">
                <Link href="/">
                    <Logo class="textBase font-medium" />
                </Link>
                <Address />
            </div>
            <div
                class="grid sm:grid-cols-2 gap-y-8 gap-x-4 lg:col-span-2 lg:col-start-4"
            >
                {
                    sections.map(({ title, links }) => (
                        <div>
                            <Text
                                tag="h3"
                                variant="textSM"
                                class=" text-base-900 font-medium uppercase"
                            >
                                {title}
                            </Text>
                            <ul role="list" class="mt-4 space-y-1">
                                {links.map(({ name, href }) => (
                                    <li>
                                        <Link
                                            href={href}
                                            class="text-sm font-medium text-base-500 hover:text-accent-600"
                                        >
                                            {name}
                                        </Link>
                                    </li>
                                ))}
                            </ul>
                        </div>
                    ))
                }
            </div>
        </div>
        <div class="border-t pt-6 border-base-200 mt-8">
            <p class="text-xs text-base-500 lg:col-span-2">
                © {currentYear} CityTrail GmbH
            </p>
        </div>
    </Wrapper>
</footer>
