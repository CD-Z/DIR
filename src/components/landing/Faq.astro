---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import Plus from "@/components/fundations/icons/Plus.astro";
const faqs = [
  {
    question: "Was ist CityTrail?",
    answer:
      "CityTrail ist eine mobile App, die dir hilft, Städte zu entdecken und Reisen zu planen. Du findest Informationen zu Sehenswürdigkeiten, Restaurants, Hotels und Bars – alles an einem Ort.",
  },
  {
    question: "Ist CityTrail wirklich kostenlos?",
    answer:
      "Ja, die Basisversion von CityTrail ist kostenlos. Du kannst damit 5 Städte erkunden, Community-Bewertungen lesen und öffentliche Reisepläne durchstöbern. Erst für detaillierte Stadtführer und Offline-Karten fallen einmalige Kosten an.",
  },
  {
    question: "Wie funktionieren die Stadtpakete?",
    answer:
      "Stadtpakete sind einmalige Käufe. Du erwirbst den vollständigen Reiseführer für eine Stadt inklusive Offline-Karten, Navigation und allen Empfehlungen – lebenslang gültig, ohne Abo.",
  },
  {
    question: "Kann ich Reisepläne mit Freunden teilen?",
    answer:
      "Ja! Du kannst deine persönlichen Reisepläne erstellen und mit Freunden oder der ganzen Community teilen. So könnt ihr eure Reisen gemeinsam planen.",
  },
  {
    question: "Sind die Karten auch offline nutzbar?",
    answer:
      "Ja, mit einem gekauften Stadtpaket stehen dir alle Karten und Navigationsdaten offline zur Verfügung. Perfekt, um im Ausland keine Roaming-Gebühren zu zahlen.",
  },
  {
    question: "Wie aktuell sind die Informationen?",
    answer:
      "Unsere Inhalte werden regelmäßig von der Community und unserem Team aktualisiert. Du findest für jede Stadt die aktuellsten Öffnungszeiten, Bewertungen und Empfehlungen.",
  },
  {
    question: "Kann ich als Nutzer Bewertungen schreiben?",
    answer:
      "Ja, nach dem Kauf eines Stadtpakets kannst du Bewertungen zu Sehenswürdigkeiten, Restaurants und Hotels schreiben und so anderen Reisenden helfen.",
  },
  {
    question: "Welche Städte sind verfügbar?",
    answer:
      "Wir starten mit europäischen Hauptstädten und erweitern unser Angebot kontinuierlich. Eine aktuelle Liste findest du in der App. Mit dem Entdecker-Pass hast du Zugriff auf alle verfügbaren Städte.",
  },
  {
    question: "Gibt es eine Geld-zurück-Garantie?",
    answer:
      "Ja, für Stadtpakete bieten wir eine 14-tägige Geld-zurück-Garantie, falls du mit dem Inhalt nicht zufrieden sein solltest.",
  },
  {
    question: "Wie kann ich CityTrail herunterladen?",
    answer:
      "CityTrail ist im Apple App Store und bei Google Play erhältlich. Folge einfach dem Download-Link auf unserer Website.",
  },
];
---

<section id="faq">
  <Wrapper variant="standard" class="py-20">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-12">
      <div>
        <Text
          tag="span"
          variant="textSM"
          class="leading-normal font-bold uppercase text-accent-700"
        >
          FAQ
        </Text>
        <Text
          tag="h2"
          variant="displayMD"
          class="tracking-tight mt-4 font-semibold text-base-900"
        >
          Häufig gestellte Fragen
        </Text>
        <Text
          tag="p"
          variant="textBase"
          class="mt-4 text-base-500 font-medium text-balance"
        >
          Antworten auf die wichtigsten Fragen zu CityTrail.
        </Text>
      </div>
      <div class="lg:col-span-2">
        {
          faqs.map((faq) => (
            <details class="group pb-4">
              <summary class="cursor-pointer flex items-center justify-between w-full text-left font-medium select-none text-base-600 hover:text-accent-800">
                <Text tag="h3" variant="textLG">
                  {faq.question}
                </Text>
                <Plus class="size-5 duration-300 ease-out text-base-500 group-open:rotate-45 shrink-0" />
              </summary>
              <Text
                tag="p"
                variant="textBase"
                class="pb-4 pt-2 text-base-500 text-balance"
              >
                {faq.answer}
              </Text>
            </details>
          ))
        }
      </div>
    </div>
  </Wrapper>
</section>
