---
// Assets
import { Image } from "astro:assets";
import DashboardLight from "@/images/dashboardLight.svg";
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<section class="overflow-hidden">
    <Wrapper class="pt-32">
        <div class="max-w-2xl text-center mx-auto lg:text-balance">
            <Text
                tag="span"
                variant="textSM"
                class="leading-normal font-bold uppercase text-accent-700"
            >
                welcome
            </Text>
            <Text
                tag="h1"
                variant="displayMD"
                class="tracking-tight mt-4 font-semibold text-base-900"
            >
                A starter template built with Astro and Tailwind CSS for your
                next project
            </Text>
            <Text
                tag="p"
                variant="textBase"
                class="mt-4 text-base-500 font-medium text-balance"
            >
                Feature sections, a pricing table, testimonial, CTA, and full
                forms.
            </Text>
            <div class="flex flex-wrap items-center gap-2 justify-center mt-12">
            </div>
        </div>

        <div class="relative w-full mx-auto max-w-7xl items-center py-12 pb-12">
        </div>
    </Wrapper>
</section>
