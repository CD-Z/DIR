---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Button from "@/components/fundations/elements/Button.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import Check from "@/components/fundations/icons/Check.astro";
const pricingTiers = [
  {
    name: "Kostenlos",
    subtitle: "Für erste Entdeckungen",
    description:
      "Perfekt, um CityTrail kennenzulernen und erste Städte zu erkunden.",
    price: "€0,00",
    features: [
      "Basisinformationen zu 5 Städten",
      "Öffentliche Reisepläne durchstöbern",
      "Community-Bewertungen lesen",
      "Kartenansicht (online)",
    ],
    cta: "Kostenlos starten",
    buttonVariant: "muted",
    isPopular: false,
    bgClass: "bg-base-50 ring-4 ring-base-50",
    textClass: "text-base-900",
    priceClass: "text-base-900",
    descClass: "text-base-500",
  },
  {
    name: "Stadtpaket",
    subtitle: "Für eine Reise",
    description:
      "Einmaliger Kauf – alle Informationen zu einer Stadt, lebenslang gültig.",
    price: "€4,99",
    features: [
      "Vollständiger Reiseführer für eine Stadt",
      "Sehenswürdigkeiten, Restaurants, Hotels & Bars",
      "Offline-Karten & Navigation",
      "Persönliche Reisepläne erstellen",
      "Bewertungen schreiben",
    ],
    cta: "Stadtpaket kaufen",
    buttonVariant: "default",
    isPopular: true,
    bgClass: "bg-accent-950 ring-4 ring-accent-50",
    textClass: "text-white",
    priceClass: "text-white",
    descClass: "text-base-200",
  },
  {
    name: "Entdecker-Pass",
    subtitle: "Für Vielflieger",
    description:
      "Zugriff auf alle Städte – das beste Angebot für regelmäßige Reisende.",
    price: "€19,99",
    features: [
      "Alle Städte & alle Inhalte",
      "Offline-Karten & Navigation",
      "Exklusive Reiseplan-Vorlagen",
      "Priorisierter Support",
      "Frühzugang zu neuen Städten",
    ],
    cta: "Entdecker-Pass kaufen",
    buttonVariant: "muted",
    isPopular: false,
    bgClass: "bg-base-50 ring-4 ring-base-50",
    textClass: "text-base-900",
    priceClass: "text-base-900",
    descClass: "text-base-500",
  },
];
---

<section id="pricing">
  <Wrapper variant="standard" class="py-20">
    <div class="max-w-xl text-center mx-auto">
      <Text
        tag="span"
        variant="textSM"
        class="leading-normal font-bold uppercase text-accent-700"
      >
        Preise
      </Text>
      <Text
        tag="h2"
        variant="displayMD"
        class="tracking-tight mt-4 font-semibold text-base-900"
      >
        Freemium für jede Reise
      </Text>
      <Text
        tag="p"
        variant="textBase"
        class="mt-4 text-base-500 font-medium text-balance"
      >
        Starte kostenlos und kaufe einzelne Städte dazu – oder hol dir den Entdecker-Pass
        für alle Städte.
      </Text>
    </div>
    <div
      class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 mt-12 mx-auto"
    >
      {
        pricingTiers.map((tier, index) => (
          <div
            class={`flex flex-col h-full p-1 lg:py-1 rounded-3xl ${tier.bgClass} border border-base-200`}
          >
            <div
              class={`p-8 ${tier.isPopular ? "bg-white/5" : "bg-white"} rounded-[1.3rem] flex flex-col justify-between`}
            >
              <div>
                <div class="flex items-start justify-between w-full">
                  <div>
                    <Text
                      tag="h3"
                      variant="textBase"
                      class={`font-medium ${tier.textClass}`}
                    >
                      {tier.name}
                    </Text>
                    <Text tag="p" variant="textSM" class={`${tier.descClass}`}>
                      {tier.subtitle}
                    </Text>
                  </div>
                  {tier.isPopular && (
                    <span class="inline-flex items-center font-medium relative text-accent-800 bg-white px-2.5 py-1 text-xs rounded-md">
                      Beliebt
                    </span>
                  )}
                </div>
                <Text
                  tag="p"
                  variant="textSM"
                  class={` mt-4 ${tier.descClass}`}
                >
                  {tier.description}
                </Text>
                <Button
                  variant={tier.buttonVariant}
                  size="base"
                  class="w-full mt-12"
                >
                  {tier.cta}
                </Button>
              </div>
            </div>
            <div class="p-8 flex flex-col">
              <Text
                tag="p"
                variant="displayMD"
                class={`font-medium flex items-baseline ${tier.priceClass}`}
              >
                {tier.price}
                <span
                  class={`text-sm font-normal tracking-normal ml-1 ${tier.isPopular ? "text-white/70" : "text-base-500"}`}
                >
                  / einmalig
                </span>
              </Text>
              <div class="mt-12">
                <Text
                  tag="p"
                  variant="textSM"
                  class={`font-medium uppercase ${tier.descClass}`}
                >
                  {tier.name} beinhaltet:
                </Text>
                <ul
                  class={`flex flex-col mt-4 gap-y-3 ${tier.descClass}`}
                  role="list"
                >
                  {tier.features.map((feature) => (
                    <li class="flex items-start gap-2">
                      <Check size="sm" />
                      <span class="text-sm leading-normal">{feature}</span>
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </Wrapper>
</section>
