---
// Fundations
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
// Icons
import Eye from "@/components/fundations/icons/Eye.astro";
import Edit from "@/components/fundations/icons/Edit.astro";
import Complete from "@/components/fundations/icons/Complete.astro";
import Color from "@/components/fundations/icons/Color.astro";

const featureItems = [
  {
    icon: Eye,
    title: "Sehenswürdigkeiten",
    description:
      "Entdecke die wichtigsten Sehenswürdigkeiten, versteckte Perlen und lokale Geheimtipps in jeder Stadt.",
  },
  {
    icon: Edit,
    title: "Reisepläne erstellen",
    description:
      "Erstelle persönliche Reiserouten, speichere deine Lieblingsorte und teile deine Pläne mit Freunden.",
  },
  {
    icon: Complete,
    title: "Empfehlungen & Bewertungen",
    description:
      "Finde die besten Restaurants, Bars und Hotels – basierend auf echten Bewertungen unserer Community.",
  },
  {
    icon: Color,
    title: "Karten & Navigation",
    description:
      "Integrierte Karten und Navigation helfen dir, dich in jeder Stadt zurechtzufinden.",
  },
];
---

<section id="features">
  <Wrapper variant="standard" class="py-20">
    <div class="text-center max-w-2xl mx-auto lg:text-balance">
      <Text
        tag="span"
        variant="textSM"
        class="leading-normal font-bold uppercase text-accent-700"
      >
        Funktionen
      </Text>
      <Text
        tag="h2"
        variant="displayMD"
        class="tracking-tight mt-4 font-semibold text-base-900"
      >
        Alles, was du für deine Städtereise brauchst
      </Text>
      <Text tag="p" variant="textBase" class="mt-4 text-base-500 font-medium">
        Von der Inspiration bis zur Navigation – CityTrail begleitet dich auf jeder Reise.
      </Text>
    </div>
    <dl
      class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12 mt-16"
    >
      {
        featureItems.map((item) => (
          <div class="text-center lg:text-left">
            <div class="flex flex-col lg:flex-row gap-4 items-center lg:items-start">
              <div class="shrink-0">
                <item.icon class="size-6 text-accent-700" />
              </div>
              <div>
                <dt>
                  <Text
                    tag="h3"
                    variant="textLG"
                    class="text-base-900 font-medium"
                  >
                    {item.title}
                  </Text>
                </dt>
                <dd>
                  <Text tag="p" variant="textBase" class="mt-2 text-base-500">
                    {item.description}
                  </Text>
                </dd>
              </div>
            </div>
          </div>
        ))
      }
    </dl>
    <!-- Feature Badge Row -->
    <div class="flex flex-wrap justify-center gap-3 mt-16">
      {
        ["Städte weltweit", "Offline-Karten", "Community-Bewertungen", "Reiseplan-Teilen", "Navigationsintegration"].map(
          (badge) => (
            <span class="inline-flex items-center font-medium text-sm text-base-700 bg-base-50 px-4 py-1.5 rounded-lg">
              {badge}
            </span>
          )
        )
      }
    </div>
  </Wrapper>
</section>
