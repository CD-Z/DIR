---
// Fundations
import "@/styles/global.css";
import BaseHead from "@/components/fundations/head/BaseHead.astro";
// Section
import Footer from "@/components/global/Footer.astro";
import Navigation from "@/components/global/Navigation.astro";
// Accessibility
import SkipLink from "@/components/global/SkipLink.astro";
// Hides the  navigation, or footer on selected screens by passing props:
// <BaseLayout hideNavigation={true} hideFooter={true}>
const { hideNavigation = false, hideFooter = false } = Astro.props;
---

<html lang="de" class="scroll-smooth">
  <head>
    <BaseHead />
  </head>
  <body class="flex flex-col bg-white min-h-dvh">
    <SkipLink />
    {!hideNavigation && <Navigation />}
    <main id="main-content" class="grow"><slot /></main>
    {!hideFooter && <Footer />}
  </body>
</html>
