---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<BaseLayout>
    <section>
        <Wrapper variant="standard" class="py-20">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-12">
                <div>
                    <div class="lg:sticky lg:top-20">
                        <Text
                            tag="h1"
                            variant="displayMD"
                            class="tracking-tight font-semibold text-base-900"
                        >
                            Barrierefreiheit
                        </Text>
                        <Text
                            tag="p"
                            variant="textBase"
                            class="mt-4 text-base-500 font-medium"
                        >
                            Stand: Mai 2026
                        </Text>
                    </div>
                </div>

                <div class="lg:col-span-2 space-y-10">
                    <!-- Erklärung -->
                    <Wrapper variant="prose" class="max-w-none">
                        <h2>Barrierefreiheitserklärung</h2>
                        <p>
                            Diese Webseite ist vollständig vereinbar mit den <a
                                href="https://www.w3.org/TR/WCAG22/"
                                >Web Content Accessibility Guidelines (WCAG) 2.2
                                AA</a
                            >.
                        </p>

                        <h2>Angaben zur Erstellung</h2>
                        <p>
                            Diese Barrierefreiheitserklärung wurde am 14. Mai
                            2026 erstellt. Sie basiert auf den Erkenntnissen aus
                            internen Untersuchungen der CityTrail GmbH, die
                            sowohl manuell als auch mit automatisierten Tools
                            durchgeführt wurden. Bei diesen Untersuchungen
                            konnten keine Barrieren festgestellt werden.
                        </p>

                        <h3>Verwendete Tools</h3>
                        <ul>
                            <li>AXE DevTools (v4.117.1)</li>
                            <li>Lighthouse Accessibility Audit</li>
                        </ul>

                        <h2>Kontakt</h2>
                        <p>
                            Sollten Sie auf Barrieren stoßen oder
                            Verbesserungsvorschläge haben, kontaktieren Sie uns
                            bitte über unser <a href="/contact"
                                >Kontaktformular</a
                            >.
                        </p>

                        <h2>Durchsetzungsverfahren</h2>
                        <p>
                            Sollten Sie mit unserer Antwort nicht zufrieden sein
                            , haben Sie das Recht bei der Österreichischen
                            Forschungsförderungsgesellschaft (FFG) Beschwerde
                            einzulegen.
                        </p>
                        <p>
                            Sie können die FFG über dieses <a
                                href="https://www.digitalbarrierefrei.at/de/beschwerdestelle/kontaktformular-beschwerdestelle"
                                >Kontaktformular</a
                            > oder eine E-Mail an <a
                                href="mailto:beschwerdestelle-wzg@ffg.at"
                                >beschwerdestelle-wzg@ffg.at</a
                            > erreichen.
                        </p>
                    </Wrapper>
                </div>
            </div>
        </Wrapper>
    </section>
</BaseLayout>
