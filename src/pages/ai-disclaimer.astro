---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<BaseLayout>
    <section>
        <Wrapper variant="standard" class="py-20">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-12">
                <div>
                    <div class="lg:sticky lg:top-20">
                        <Text
                            tag="h1"
                            variant="displayMD"
                            class="tracking-tight font-semibold text-base-900"
                        >
                            KI-Erstellte Inhalte
                        </Text>
                        <Text
                            tag="p"
                            variant="textBase"
                            class="mt-4 text-base-500 font-medium"
                        >
                            Transparenz über den Einsatz Künstlicher Intelligenz
                        </Text>
                        <Text
                            tag="p"
                            variant="textBase"
                            class="mt-4 text-base-500 font-medium"
                        >
                            <b>Stand: </b> Mai 2026
                        </Text>
                    </div>
                </div>

                <div class="lg:col-span-2 space-y-10">
                    <Wrapper variant="prose" class="max-w-none">
                        <h2>Einsatz von KI auf dieser Website</h2>
                        <p>
                            Bei der Erstellung der Inhalte und des Layouts
                            dieser Webseite wurde Künstliche Intelligenz
                            eingesetzt. Nachfolgend wird der Umfang der
                            KI-Nutzung offengelegt.
                        </p>

                        <h2>Code-Generierung</h2>
                        <p>
                            Der Quellcode dieser Website wurde mit Unterstützung
                            von dem KI-Tool "Github Copilot" erstellt.
                            Spezifische Einsatzzwecke waren:
                        </p>
                        <ul>
                            <li>Erstellung von Astro-Komponenten und Seiten</li>
                            <li>
                                Erstellung von Unterseitenstrukturen und
                                Routing-Logik
                            </li>
                            <li>Implementierung des Tailwind CSS-Layouts</li>
                            <li>Globale CSS-Klassen</li>
                        </ul>
                        <p>
                            Sämtlicher Code wurde manuell geprüft und an die
                            Anforderungen des Projekts angepasst.
                        </p>

                        <h2>Texte und Inhalte</h2>
                        <p>
                            Es wurden <b>ausschließlich</b> die Texte auf der <a
                                href="/">Startseite</a
                            >
                            durch das KI-Tool "Github Copilot" generiert.
                        </p>

                        <h2>Zweck dieser Offenlegung</h2>
                        <p>
                            Diese Offenlegung dient der Transparenz gegenüber
                            den Prüfern und der klaren Abgrenzung von KI
                            generierten Inhalten und bewertungsrelevanten
                            handgeschriebenen Inhalten.
                        </p>
                    </Wrapper>
                </div>
            </div>
        </Wrapper>
    </section>
</BaseLayout>
