---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
import Link from "@/components/fundations/elements/Link.astro";
import W from "@/components/fundations/elements/W.astro";
---

<BaseLayout>
    <section>
        <Wrapper variant="standard" class="py-20">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-12">
                <div>
                    <div class="lg:sticky lg:top-20">
                        <Text
                            tag="h1"
                            variant="displayMD"
                            class="tracking-tight font-semibold text-base-900"
                        >
                            Urheberrechts<W />hinweise
                        </Text>
                        <Text
                            tag="p"
                            variant="textBase"
                            class="mt-4 text-base-500 font-medium"
                        >
                            Lizenzen und Quellenangaben aller verwendeten Medien
                        </Text>
                        <Text
                            tag="p"
                            variant="textBase"
                            class="mt-4 text-base-500 font-medium"
                        >
                            Stand: Mai 2026
                        </Text>
                    </div>
                </div>

                <div class="lg:col-span-2 space-y-10">
                    <Wrapper variant="prose" class="max-w-none">
                        <h2>Bilder</h2>
                        <p>
                            Alle auf dieser Website verwendeten Fotografien
                            stammen von
                            <a href="https://unsplash.com/">Unsplash</a> und werden
                            unter der
                            <a href="https://unsplash.com/license"
                                >Unsplash-Lizenz</a
                            > genutzt. Diese erlaubt die kostenlose Nutzung, Bearbeitung
                            und Verbreitung der Bilder für kommerzielle und nicht-kommerzielle
                            Zwecke ohne Namensnennung. Dennoch möchten wir die Fotografen
                            namentlich nennen:
                        </p>

                        <ul>
                            <li>
                                <b>Yoav Aziz</b> -
                                <a href="https://unsplash.com/de/@yoavaziz"
                                    >@yoavaziz</a
                                > - <a
                                    href="https://unsplash.com/photos/an-aerial-view-of-a-city-square-with-a-monument-in-the-middle-eNb4JSCt9Uk"
                                    >Original</a
                                >
                            </li>
                        </ul>

                        <h2>Videoaufnahmen</h2>
                        <p>
                            Alle auf dieser Website verwendeten Videoaufnahmen
                            stammen von
                            <a href="https://pexels.com/">Pexels</a> und werden unter
                            der
                            <a href="https://pexels.com/license"
                                >Pexels-Lizenz</a
                            > genutzt. Diese erlaubt die kostenlose Nutzung, Bearbeitung
                            und Verbreitung der Bilder für kommerzielle und nicht-kommerzielle
                            Zwecke ohne Namensnennung. Dennoch möchten wir die Fotografen
                            namentlich nennen:
                        </p>

                        <ul>
                            <li>
                                <b>Julio Lopez</b> -
                                <a
                                    href="https://www.pexels.com/@julio-lopez-75309646/"
                                    >@julio-lopez-75309646</a
                                > - <a
                                    href="https://www.pexels.com/video/elegant-historic-building-interior-at-night-29952781/"
                                    >Original</a
                                >
                            </li>
                        </ul>

                        <h2>Schriftarten</h2>
                        <p>
                            Alle Schriftfamilien sind über
                            <a href="https://fonts.google.com/specimen/Geist"
                                >Google Fonts</a
                            >
                            verfügbar. Die verwendeten Schriftfamilien sind:
                        </p>
                        <ul>
                            <li>
                                <b>Geist</b> - <a
                                    href="https://fonts.google.com/specimen/Geist"
                                    >Google Fonts</a
                                > (SIL Open Font License 1.1)
                            </li>
                        </ul>

                        <h2>Software und Frameworks</h2>
                        <p>
                            Diese Website verwendet folgende
                            Open-Source-Software:
                        </p>
                        <ul>
                            <li>
                                <b>Astro</b> -
                                <a href="https://astro.build">astro.build</a> (MIT-Lizenz)
                            </li>
                            <li>
                                <b>AstroSaaS</b> -
                                <a
                                    href="https://astro.build/themes/details/astrosaas/"
                                    >astro.build/themes</a
                                > (GPL3.0-Lizenz)
                            </li>
                            <li>
                                <b>Tailwind CSS</b> -
                                <a href="https://tailwindcss.com"
                                    >tailwindcss.com</a
                                > (MIT-Lizenz)
                            </li>
                        </ul>

                        <h2>Icons und Grafiken</h2>
                        <p>
                            Alle verwendeten Icons stammen aus dem Astro theme <a
                                href="https://astro.build/themes/details/astrosaas/"
                                >AstroSaaS</a
                            >.
                        </p>

                        <h2>Kontakt bei Urheberrechtsfragen</h2>
                        <p>
                            Sollten Sie der Ansicht sein, dass einer oder
                            mehrere unserer Inhalte gegen Ihr Urheberrecht
                            verstößt, dann kontaktieren Sie uns bitte über unser <Link
                                href="/contact">Kontaktformular</Link
                            >.
                        </p>
                    </Wrapper>
                </div>
            </div>
        </Wrapper>
    </section>
</BaseLayout>
