---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Text from "@/components/fundations/elements/Text.astro";
import Wrapper from "@/components/fundations/containers/Wrapper.astro";
---

<BaseLayout>
    <section>
        <Wrapper variant="standard" class="py-20">
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 lg:gap-12">
                <div>
                    <div class="lg:sticky lg:top-20">
                        <Text
                            tag="h1"
                            variant="displayMD"
                            class="tracking-tight font-semibold text-base-900"
                        >
                            Urheberrechtshinweise
                        </Text>
                        <Text
                            tag="p"
                            variant="textBase"
                            class="mt-4 text-base-500 font-medium"
                        >
                            Lizenzen und Quellenangaben aller verwendeten Medien
                        </Text>
                    </div>
                </div>

                <div class="lg:col-span-2 space-y-10"></div>
            </div>
        </Wrapper>
    </section>
</BaseLayout>
